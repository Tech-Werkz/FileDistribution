<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}}</title>
  <script>
    (function () {
      var root = document.documentElement;
      var host = null;
      try { if (window.parent !== window && window.parent.document) host = window.parent; } catch (e) { host = null; }

      var link = document.createElement('link');
      link.id = 'theme-stylesheet';
      link.rel = 'stylesheet';
      document.head.appendChild(link);

      function hostThemeLink() { return host ? host.document.getElementById('theme-stylesheet') : null; }

      function standaloneMode() {
        var n = '0';
        try { n = localStorage.getItem('nightMode') || '0'; } catch (e) { }
        if (n == '1') return 'dark';
        if (n == '2') return 'light';
        return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      }

      function standaloneHref() {
        var t = 'default';
        try { t = localStorage.getItem('theme') || 'default'; } catch (e) { }
        if (!/^[a-z0-9_-]+$/i.test(t) || t == 'default') return 'styles/bootstrap-min.css';
        return 'styles/themes/' + encodeURIComponent(t.toLowerCase()) + '/bootstrap-min.css';
      }

      function apply() {
        var href, mode;
        var hl = hostThemeLink();
        if (host && hl) {
          href = hl.href;
          mode = host.document.documentElement.getAttribute('data-bs-theme') || 'light';
          root.removeAttribute('data-st-classic');
        } else if (host) {
          href = 'styles/bootstrap-min.css';
          mode = (host.document.body && host.document.body.classList.contains('night')) ? 'dark' : 'light';
          root.setAttribute('data-st-classic', '1');
        } else {
          href = standaloneHref();
          mode = standaloneMode();
        }
        if (link.getAttribute('href') !== href) link.setAttribute('href', href);
        if (root.getAttribute('data-bs-theme') !== mode) root.setAttribute('data-bs-theme', mode);
      }

      apply();

      if (host) {
        var observer = new MutationObserver(apply);
        observer.observe(host.document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
        var hl = hostThemeLink();
        if (hl) observer.observe(hl, { attributes: true, attributeFilter: ['href'] });
        if (host.document.body) observer.observe(host.document.body, { attributes: true, attributeFilter: ['class'] });
        window.addEventListener('pagehide', function () { observer.disconnect(); });
      } else {
        window.addEventListener('storage', apply);
        if (window.matchMedia) window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply);
      }
    })();
  </script>
  <style>
    :root {
      --fd-page-bg: var(--bs-body-bg);
      --fd-panel-bg: var(--bs-tertiary-bg);
      --fd-panel-border: var(--bs-border-color);
      --fd-panel-text: var(--bs-body-color);
      --fd-danger-bg: var(--bs-danger-bg-subtle);
      --fd-danger-border: var(--bs-danger-border-subtle);
      --fd-danger-text: var(--bs-danger-text-emphasis);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      width: 100%;
      min-height: 100%;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: var(--fd-page-bg);
      color: var(--fd-panel-text);
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .fd-alert {
      width: min(38rem, 100%);
      background: var(--fd-danger-bg);
      border: 1px solid var(--fd-danger-border);
      color: var(--fd-danger-text);
      border-radius: var(--bs-border-radius);
      box-shadow: var(--bs-box-shadow-sm);
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: 1rem 1.25rem;
      font-size: clamp(1rem, 1.4vw, 1.15rem);
      line-height: 1.45;
    }

    .fd-alert-icon {
      flex: none;
      width: 1.25rem;
      height: 1.25rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      opacity: .9;
    }

    .fd-alert-message {
      margin: 0;
      font-weight: 500;
    }
  </style>
</head>
<body>
  <div class="fd-alert" role="alert" aria-live="assertive">
    <span class="fd-alert-icon" aria-hidden="true">⚠</span>
    <p class="fd-alert-message">{{message}}</p>
  </div>
</body>
</html>
